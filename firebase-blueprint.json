{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "System users including admins, affiliates, and customers.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "role": { "type": "string", "enum": ["admin", "affiliate", "customer"] },
        "commissionEarned": { "type": "number" },
        "totalSales": { "type": "number" },
        "referralCode": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "email", "role"]
    },
    "Product": {
      "title": "Product",
      "description": "Digital products or courses sold on the platform.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "price": { "type": "number" },
        "imageUrl": { "type": "string" },
        "category": { "type": "string" },
        "modules": {
          "type": "array",
          "items": { "type": "object", "properties": { "title": { "type": "string" }, "content": { "type": "string" } } }
        },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "price"]
    },
    "Sale": {
      "title": "Sale Transaction",
      "description": "Records of product purchases.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "productId": { "type": "string" },
        "buyerId": { "type": "string" },
        "affiliateId": { "type": "string" },
        "amount": { "type": "number" },
        "commission": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["productId", "buyerId", "amount"]
    },
    "Review": {
      "title": "Product Review",
      "description": "User ratings and feedback for products.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "productId": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "rating": { "type": "number", "minimum": 1, "maximum": 5 },
        "comment": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["productId", "userId", "rating", "comment"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles and settings."
    },
    "/products/{productId}": {
      "schema": "Product",
      "description": "Catalog of digital products."
    },
    "/sales/{saleId}": {
      "schema": "Sale",
      "description": "Transaction logs for sales and commissions."
    },
    "/reviews/{reviewId}": {
      "schema": "Review",
      "description": "Customer feedback and ratings."
    }
  }
}
