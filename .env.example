# ============================================
# ENVIRONMENT VARIABLES — copy ke Railway
# ============================================

# Node environment
NODE_ENV=production

# App URL (Railway akan isi otomatis, atau isi manual)
APP_URL=https://your-app.up.railway.app

# Stripe
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Firebase Service Account (paste the contents of your service account JSON as a single-line JSON string)
# How to: open your Firebase service account JSON, copy all its contents, paste here as one line (no newlines)
# This variable name must match exactly — the server reads process.env.SERVICE_ACCOUNT_KEY
SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"..."}

# Email (opsional — untuk kirim email konfirmasi)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=email@gmail.com
SMTP_PASS=app-password-gmail

# Gemini AI (opsional)
GEMINI_API_KEY=
