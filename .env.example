# ============================================
# ENVIRONMENT VARIABLES — copy ke Railway
# ============================================

# Node environment
NODE_ENV=production

# App URL (Railway akan isi otomatis, atau isi manual)
APP_URL=https://your-app.up.railway.app

# Stripe
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Firebase Service Account (paste isi serviceAccountKey.json sebagai 1 baris JSON)
# Cara: buka serviceAccountKey.json, copy semua isinya, paste di sini tanpa newline
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}

# Email (opsional — untuk kirim email konfirmasi)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=email@gmail.com
SMTP_PASS=app-password-gmail

# Gemini AI (opsional)
GEMINI_API_KEY=
