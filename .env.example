# ============================================
# ENVIRONMENT VARIABLES — copy ke Railway
# ============================================

# Node environment
NODE_ENV=production

# App URL — Railway generate otomatis, format: https://<nama-service>.up.railway.app
# Ganti sesuai nama service yang kamu buat di Railway
APP_URL=https://digisell.up.railway.app
APP_DOMAIN=digisell.up.railway.app

# Stripe
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Firebase Service Account (paste isi serviceAccountKey.json sebagai 1 baris JSON)
# Cara: buka serviceAccountKey.json, copy semua isinya, paste di sini tanpa newline
# Project ID kamu: webstite-affilate
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"webstite-affilate","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk-...@webstite-affilate.iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token"}

# Email (opsional — untuk kirim email konfirmasi)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=email@gmail.com
SMTP_PASS=app-password-gmail

# Gemini AI (opsional)
GEMINI_API_KEY=

# PORT — Railway inject otomatis, tidak perlu diisi manual
# PORT=3000
