rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 0. Default Deny All
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn() && getUserData().role == 'admin';
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- User Validation ---
    function isValidUser(data) {
      return data.id == request.auth.uid
        && data.email == request.auth.token.email
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 100
        && data.role in ['admin', 'affiliate', 'customer'];
    }

    // --- Collections ---

    // Users
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isSignedIn()
        && isValidUser(incoming())
        && (incoming().role == 'customer' || incoming().role == 'affiliate');
      // Only allow updating safe fields by owner; role changes via server API only
      allow update: if (isOwner(userId) && incoming().diff(existing()).affectedKeys()
        .hasOnly(['name', 'wishlist', 'country', 'isIndonesian', 'updatedAt']))
        || isAdmin();
    }

    // Products — public read, server-only write
    match /products/{productId} {
      allow read: if true;
      allow write: if false;
    }

    // Reviews — public read, authenticated write (own reviews only)
    match /products/{productId}/reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && request.auth.uid == existing().userId;
    }

    // Sales — users see own records, server creates
    match /sales/{saleId} {
      allow get: if isSignedIn() && (
        existing().buyerId == request.auth.uid
        || existing().affiliateId == request.auth.uid
        || isAdmin()
      );
      allow list: if isAdmin();
      allow write: if false;
    }

    // Global settings — public read, server-only write
    match /settings/global {
      allow read: if true;
      allow write: if false;
    }

    // Coupons — public read, server-only write
    match /coupons/{couponId} {
      allow read: if true;
      allow write: if false;
    }

    // Withdrawals — owner or admin read, server-only write
    match /withdrawals/{withdrawalId} {
      allow get: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow write: if false;
    }

    // Activity Logs — admin only
    match /activityLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
