rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 0. Default Deny All
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn() && getUserData().role == 'admin';
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- User Validation ---
    function isValidNewUser(data) {
      return data.id == request.auth.uid
        && data.email is string
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 100
        && data.role in ['affiliate', 'customer'];
    }

    // --- Collections ---

    // Users
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      // New user can only create their own doc with safe role
      allow create: if isSignedIn()
        && isOwner(userId)
        && isValidNewUser(incoming());
      // Owner can only update safe fields; role changes via server API only
      allow update: if (isOwner(userId)
          && incoming().diff(existing()).affectedKeys()
            .hasOnly(['name', 'wishlist', 'country', 'isIndonesian', 'updatedAt']))
        || isAdmin();
      allow delete: if false;
    }

    // Products — public read, server-only write
    match /products/{productId} {
      allow read: if true;
      allow write: if false;
    }

    // Reviews — stored as top-level collection (not subcollection)
    match /reviews/{reviewId} {
      allow read: if true;
      // Write only via server API (purchase verification done server-side)
      allow write: if false;
    }

    // Sales — users see own records, server creates/updates
    match /sales/{saleId} {
      allow get: if isSignedIn() && (
        existing().buyerId == request.auth.uid
        || existing().affiliateId == request.auth.uid
        || isAdmin()
      );
      allow list: if isAdmin();
      allow write: if false;
    }

    // Global settings — public read, server-only write
    match /settings/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Coupons — authenticated read (needed for client-side validation), server-only write
    match /coupons/{couponId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Withdrawals — owner or admin read, server-only write
    match /withdrawals/{withdrawalId} {
      allow get: if isSignedIn() && (
        existing().userId == request.auth.uid || isAdmin()
      );
      allow list: if isAdmin()
        || (isSignedIn() && request.auth.uid != null
          && resource.data.userId == request.auth.uid);
      allow write: if false;
    }

    // Activity Logs — admin read only, server-only write
    match /activityLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Email Templates — admin read/write via server only
    match /emailTemplates/{templateId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Blog Posts — public read, server-only write
    match /blogPosts/{postId} {
      allow read: if true;
      allow write: if false;
    }

    // Media Files — authenticated read, server-only write
    match /mediaFiles/{fileId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Static Pages — public read, server-only write
    match /staticPages/{pageId} {
      allow read: if true;
      allow write: if false;
    }

    // Notifications — owner read/write
    match /notifications/{notifId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    // Resources — authenticated read, server-only write
    match /resources/{resourceId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Clicks — server-only (analytics data)
    match /clicks/{clickId} {
      allow read: if false;
      allow write: if false;
    }

    // Refunds — admin read, server-only write
    match /refunds/{refundId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Fraud Alerts — admin read, server-only write
    match /fraud_alerts/{alertId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Deeplinks — authenticated read, server-only write
    match /deeplinks/{linkId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Payout Methods — owner read/write
    match /payoutMethods/{methodId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    // Terms — public read, server-only write
    match /terms/{termId} {
      allow read: if true;
      allow write: if false;
    }

    // Multi-tier Referrals — admin read, server-only write
    match /multiTierReferrals/{referralId} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
